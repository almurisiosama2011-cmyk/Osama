-- القفل على الراس
local function screenDist(head)
	local pos, onScreen = cam:WorldToViewportPoint(head.Position)
	if not onScreen then return nil end
	return (Vector2.new(pos.X, pos.Y) - cam.ViewportSize / 2).Magnitude
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function visible(head)
	rayParams.FilterDescendantsInstances = {lp.Character, head.Parent}
	local origin = cam.CFrame.Position
	return workspace:Raycast(origin, head.Position - origin, rayParams) == nil
end

local function valid(head)
	if not head or not head.Parent then return false end
	local hum = head.Parent:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	local d = screenDist(head)
	return d ~= nil and d <= RADIUS and visible(head)
end

RunService:BindToRenderStep("HeadLock", Enum.RenderPriority.Camera.Value + 1, function()
	if not lockOn then return end
	if not valid(locked) then
		locked = nil
		local bestDist
		for _, p in ipairs(Players:GetPlayers()) do
			local head = p ~= lp and p.Character and p.Character:FindFirstChild("Head")
			if head and valid(head) then
				local d = screenDist(head)
				if not bestDist or d < bestDist then
					locked, bestDist = head, d
				end
			end
		end
	end

	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if hum then hum.AutoRotate = (locked == nil) end
	if locked then
		cam.CFrame = CFrame.lookAt(cam.CFrame.Position, locked.Position)
		if root then
			local t = locked.Position
			root.CFrame = CFrame.lookAt(root.Position, Vector3.new(t.X, root.Position.Y, t.Z))
		end
	end
end)
