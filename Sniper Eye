-- وظائف الأزرار
local function setLock(v)
	lockOn = v
	circle.Visible = v
	circleBtn.Text = "Circle: " .. (v and "ON" or "OFF")
	circleBtn.BackgroundColor3 = v and GREEN or RED
	if not v then
		locked = nil
		local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if h then h.AutoRotate = true end
	end
end

local function setOutlines(v)
	outlinesOn = v
	outlineBtn.Text = "Outlines: " .. (v and "ON" or "OFF")
	outlineBtn.BackgroundColor3 = v and GREEN or RED
	for _, p in ipairs(Players:GetPlayers()) do
		local o = p.Character and p.Character:FindFirstChild("Outline")
		if o then o.Enabled = v end
	end
end

local function setMenu(v)
